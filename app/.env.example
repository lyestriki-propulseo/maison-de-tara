# ============================================================
# Maison de Tara — app admin (TanStack Start, SSR sur Node)
# Modèle de variables d'environnement. Copier en .env et remplir.
# .env est gitignoré : ne jamais y committer de vraie clé.
#
# DÉPLOIEMENT COOLIFY — le Dockerfile impose DEUX familles distinctes :
#   • VITE_*   → onglet "Build Variables" (Build Arguments).
#                Figées dans le bundle client AU BUILD par Vite.
#                => une clé mise ici devient PUBLIQUE (visible navigateur).
#   • le reste → onglet "Environment Variables" (runtime).
#                Injectées dans le conteneur, lues par le serveur Node
#                via process.env (validées par src/env.ts).
#
# RÈGLE DE SÉCURITÉ : ne JAMAIS préfixer un secret par VITE_.
# La service_role et les clés Monetico/Brevo restent en runtime serveur.
# ============================================================

# ---- BUILD (client) — Coolify : Build Variables ----------------
# Projet Supabase côté navigateur. La clé "anon" est publique par
# nature (protégée par les Row Level Security), donc OK à bundler.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- RUNTIME (serveur) — Coolify : Environment Variables -------
# Lues par le serveur Node au démarrage (src/env.ts les valide).
# SUPABASE_SERVICE_ROLE_KEY = SECRET ABSOLU (bypasse les RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NODE_ENV : déjà forcé à "production" dans le Dockerfile.
# Ne le remettre ici que pour un cas particulier.
NODE_ENV=production

# ---- PAS ENCORE BRANCHÉ (runtime serveur, à remplir plus tard) --
# La brique Monetico existe (fonctions pures testées) mais aucune
# route ne la câble encore, et l'envoi d'emails Brevo non plus.
# => inutiles pour que le site tourne aujourd'hui ; à renseigner
#    quand le flux réservation + paiement + email sera posé.
MONETICO_SOCIETE=
MONETICO_TPE=
MONETICO_CLE_MAC=
MONETICO_URL_SERVER=
MONETICO_URL_RETOUR_OK=
MONETICO_URL_RETOUR_ERR=
BREVO_API_KEY=

# ---- OUTILLAGE LOCAL UNIQUEMENT (NE PAS mettre sur Coolify) -----
# Chaîne de connexion Postgres directe, pour la CLI Supabase et les
# migrations depuis ta machine. Le serveur en prod n'en a pas besoin.
SUPABASE_DB_URL=

# ---- DÉPLOIEMENT COOLIFY (outillage — NE PAS mettre sur Coolify) -
# Pour déclencher un déploiement via l'API Coolify (ex. depuis un
# script ou l'assistant). NON consommé par l'app elle-même.
#   COOLIFY_URL   = URL de base de l'instance (https://coolify.tondomaine)
#                   OU l'URL de webhook de déploiement fournie par Coolify.
#   COOLIFY_TOKEN = jeton API (Bearer), généré dans Coolify > Keys & Tokens.
# Si COOLIFY_URL est l'URL de base (sans UUID), il faut EN PLUS l'UUID de
# la ressource à déployer -> décommenter COOLIFY_APP_UUID.
COOLIFY_URL=
COOLIFY_TOKEN=
#COOLIFY_APP_UUID=
